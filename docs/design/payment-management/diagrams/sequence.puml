@startuml
title Payment-management - trình duyệt, chống trùng và gửi thông báo
caption US-PAY-02; PAY-01/02/04/06/07; NFR-PAY-01; PAY-DEC-002/005/009/011/012/014. TO-BE đề xuất kỹ thuật.
skinparam defaultFontName Arial
autonumber
actor "Phụ trách\nNVKD/KTT điều chỉnh" as User
boundary PaymentApi as Api
control PaymentService as Service
participant SourceGateway as Source
participant ApprovalPolicy as Policy
database "PaymentRepository\nUnitOfWork" as Repo
control NotificationDispatcher as Worker
participant NotificationChannel as Channel

User -> Api : A06 POST /payment-documents/{id}/submissions\n{}, If-Match, Idempotency-Key
Api -> Service : submit(id), ActorContext và preconditions
Service -> Repo : kiểm quyền, receipt, document hiện hành
Repo --> Service : document + receipt nếu có
alt receipt cùng key/fingerprint hoặc đang PendingApproval
  Service --> Api : receipt cùng submission (không outbox mới)
  Api --> User : 200 hoặc receipt đã lưu; vẫn kiểm quyền
else Draft và version đúng
  Service -> Source : load(contractId, period, mode)
  Source --> Service : bundle nhất quán hoặc lỗi
  Service -> Source : compare(snapshot, bundle)
  Source --> Service : khác biệt ảnh hưởng / không đổi
  alt nguồn lỗi/đổi; thiếu dịch vụ; hai tổng không hợp lệ
    Service --> Api : SOURCE_CHANGED/UNAVAILABLE/INVALID\nMISSING_REQUIRED_SERVICE/NEGATIVE_TOTAL
    Api --> User : 409/422/503; giữ Draft
  else căn cứ/tiền hợp lệ, điều chỉnh đủ biên bản
    Service -> Policy : select(officialTotal, unit, excludedSubjects)
    Policy --> Service : người được giao cùng role hoặc không có
    alt không có người duyệt độc lập
      Service --> Api : NO_ELIGIBLE_APPROVER
      Api --> User : 422; giữ Draft, báo đầu mối phân công
    else có người hợp lệ
      group TX-SUBMIT cục bộ
        Service -> Repo : khóa chain/document; kiểm lại version/assignment
        alt lệnh khác đã trình cùng revision
          Repo --> Service : submission hiện hành; không chèn outbox
        else Draft vẫn hợp lệ
          Service -> Repo : submission + PendingApproval + audit\n+ Notification Queued + receipt; commit
          Repo --> Service : receipt, version mới
        end
      end
      Service --> Api : receipt trình thành công
      Api --> User : 201 mới / 200 hiện hữu; trạng thái gửi thực tế
    end
  end
else trạng thái khác hoặc version Draft cũ
  Service --> Api : INVALID_STATE / VERSION_CONFLICT
  Api --> User : 409 / 412; không thay đổi
end

== Sau commit, xử lý nền độc lập phản hồi API ==
Worker -> Repo : claim Notification đến hạn; kiểm submission/assignment hiện hành
Repo --> Worker : công việc hiện hành hoặc lỗi thời
alt không còn PendingApproval hoặc người nhận đã đổi
  Worker -> Repo : đánh dấu Obsolete, không gửi
else yêu cầu còn hiệu lực
  Worker -> Channel : send(recipient, submissionRef)
  Channel --> Worker : delivered / failed / unknown
  alt gửi thành công
    Worker -> Repo : attempt Delivered; cập nhật Notification
  else lỗi
    Worker -> Repo : ghi attempt, firstFailureAt; Retrying
    loop tối đa 3 retry ở +1/+5/+14 phút, trong 15 phút
      Worker -> Repo : kiểm trạng thái/assignment; claim lượt đến hạn
      opt vẫn hiện hành và chưa thành công
        Worker -> Channel : send(cùng submissionRef, người nhận hiện hành)
        Channel --> Worker : delivery result
        Worker -> Repo : ghi attempt/result, không đổi trạng thái bảng
      end
    end
    opt còn lỗi sau giới hạn hoặc worker chạy lại quá hạn
      Worker -> Repo : NeedsAttention cho vận hành; không retry tự động thêm
    end
  end
end
note over Worker,Channel
  Crash sau delivery có thể gây gửi lặp cùng tham chiếu.
  Link luôn kiểm quyền hiện hành; không hứa exactly-once kênh ngoài.
  Inbox A14 đọc submission DB dù thông báo lỗi.
end note
@enduml
